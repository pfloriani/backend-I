<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= time.nome %> - Catálogo de Times</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
  </head>
  <body class="blue-grey lighten-5">
    <nav class="blue-grey darken-3">
      <div class="nav-wrapper container">
        <a href="/" class="brand-logo">Catálogo de Times</a>
        <ul class="right">
          <li><a href="/times">Times</a></li>
        </ul>
      </div>
    </nav>
    <main class="container section">
      <div class="row">
        <div class="col s12 m8 offset-m2">
          <div class="card">
            <div class="card-content">
              <span class="card-title"><%= time.nome %></span>
              <ul class="collection">
                <li class="collection-item"><strong>ID:</strong> <%= time.id %></li>
                <li class="collection-item"><strong>Estádio:</strong> <%= time.estadio %></li>
                <li class="collection-item"><strong>Cidade:</strong> <%= time.cidade %></li>
              </ul>
            </div>
            <div class="card-action">
              <a href="/times">Voltar à lista de times</a>
            </div>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
